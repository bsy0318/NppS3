# NppS3 integration-test configuration — template only.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Process environment variables take precedence over this file.
#
# For a free local target, start the bundled MinIO container instead:
#   docker compose -f tests/docker/docker-compose.yml up -d --wait
#   . .\tests\docker\minio-env.ps1

# Endpoint of the S3-compatible service.
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Amazon S3:     https://s3.<region>.amazonaws.com
#   MinIO (local): http://127.0.0.1:9000
NPPS3_TEST_ENDPOINT=

# Cloudflare account id. Optional; only used to build a default R2 endpoint.
NPPS3_TEST_ACCOUNT_ID=

NPPS3_TEST_ACCESS_KEY_ID=
NPPS3_TEST_SECRET_ACCESS_KEY=

# Bucket the tests may create and delete objects in, under the prefix
# npps3-integration-test/<run-id>/. Nothing outside that prefix is touched.
NPPS3_TEST_BUCKET=

# Signing region. Defaults to "auto" (Cloudflare R2). Amazon S3 needs the
# bucket's real region, e.g. us-east-1.
NPPS3_TEST_REGION=

# Set to 1 to also run the >4 GiB multipart upload test. It transfers over
# 4 GiB and needs matching free space locally and in the bucket.
NPPS3_TEST_HUGE=
